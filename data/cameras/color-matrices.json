{
  "schema": 1,
  "id": "color-matrices",
  "purpose": "The D65 colour matrix of each Sony body, for the Before view (the photo as the camera would render it by default). Not used by the final picture, whose colour comes from the spectral profiles.",
  "provenance": "Numbers from the bodies' published D65 colour matrices (docs/14-licensing.md rule 8: numbers only, no table layout or text from the publishing project). Read for each body by its Sony model ID.",
  "matrix": "xyz_d65_to_camera: 3x3, rows are the camera R, G, B responses to CIE XYZ under D65, as published. The loader scales each row so that D65 white maps to camera [1, 1, 1] and inverts it (ym_color::camera_default).",
  "fallback": "ILCE-7RM4",
  "fallback_note": "A body that is not listed, or has no Sony model ID and an unknown model string, uses the fallback entry, as the profile registry falls back to the A7R IV profile.",
  "excluded": [
    {"model": "ILCE-7M5", "model_id": 407, "reason": "no published matrix of its own; a lookup returns another body's"},
    {"model": "ILCE-7RM6", "model_id": 410, "reason": "no published matrix of its own; a lookup returns another body's"},
    {"model": "ILCE-1M2", "model_id": 400, "reason": "the published numbers equal ILCE-1's, which looks like a prefix match, not a measurement"},
    {"model": "ILCE-3000", "reason": "no published matrix of its own; a lookup returns the generic E-mount numbers, the same as for any ILCE or NEX name that is not listed"}
  ],
