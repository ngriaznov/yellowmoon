{
  "name": "jdd-overfit",
  "seed": 11,
  "device": "cpu",
  "deterministic": true,
  "model": {
    "channels": [
      32,
      64,
      96
    ],
    "convs_per_level": 2,
    "up_kernel": 1,
    "head_kernel": 1,
    "head_init_scale": 0.1
  },
  "data": {
    "patch_half": 16,
    "n_train": 8,
    "n_val": 8,
    "val_same_as_train": true,
    "synthetic_weight": 1.0
  },
  "sampler": {
    "p_clean": 0.0,
    "p_craw": 0.3,
    "p_12bit": 0.1,
    "p_highlight": 0.2
  },
  "optim": {
    "lr": 0.003,
    "weight_decay": 0.0,
    "betas": [
      0.9,
      0.99
    ],
    "warmup_steps": 20,
    "final_lr_fraction": 0.05,
    "grad_clip": 1.0
  },
  "loss": {
    "w_ssim": 0.2,
    "w_grad": 0.5
  },
  "train": {
    "steps": 500,
    "batch_size": 8,
    "num_workers": 0,
    "log_every": 50,
    "eval_every": 0,
    "ckpt_every": 0,
    "threads": 2
  }
}
