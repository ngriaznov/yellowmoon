<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged by Tauri into the Info.plist of the app (src-tauri/Info.plist is read automatically). -->
	<!-- "Move to Trash" in the look import wizard asks Finder to trash the zip (the `trash` crate's
	     default on macOS runs `tell application "Finder" to delete`). Without this text macOS refuses
	     the Apple event or asks without saying why. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Yellowmoon asks Finder to move a look package you imported to the Trash. It does nothing else with Finder.</string>
</dict>
</plist>
