{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yellowmoon",
  "mainBinaryName": "Yellowmoon",
  "identifier": "app.yellowmoon",
  "build": {
    "beforeDevCommand": "tools/dev/prepare-sidecar.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yellowmoon",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: ym-frame: http://ym-frame.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/ym"],
    "resources": {
      "../data/alexa": "data/alexa",
      "../data/arri": "data/arri",
      "../data/cameras": "data/cameras",
      "../data/looks/builtin": "data/looks/builtin",
      "../data/looks/arri-packages.json": "data/looks/arri-packages.json",
      "../data/models": "data/models",
      "../NOTICE": "NOTICE",
      "../LICENSE": "LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY (generated by the agent in M0-03, docs/12)",
      "endpoints": [
        "https://github.com/ngriaznov/yellowmoon/releases/latest/download/latest.json"
      ]
    }
  }
}
