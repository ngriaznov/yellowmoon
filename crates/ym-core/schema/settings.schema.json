{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngriaznov/yellowmoon/crates/ym-core/schema/settings.schema.json",
  "title": "Yellowmoon DevelopSettings",
  "description": "The settings of one photo (docs/23 section 3, docs/01 section DevelopSettings): the node-first JSON of the ym:Settings XMP property, of `ym render --settings`, of the golden-image manifest and of the IPC types in src/api/types.ts. A photo's settings are the graph of its nodes; `{}` is the default graph. Every property is optional when reading (a missing one takes its default, shown here); unknown properties are refused, and so is a flat document in the form of Yellowmoon 0.1. Values outside their ranges are clamped by the core, not refused; the ranges here are the ones the core clamps to. Not expressible in JSON Schema and checked by the core: the rules of the graph (exactly one Input, Output and Main; ports and types of links; one link per input; Main takes its picture from the Input; no circle; at most 64 correctors, 64 masks a node, 100,000 brush points, 256 Object points), colour-balance points lie in the unit disc (a longer vector is scaled back to its circle), colour-warp points lie in the disc of radius 0.5 (likewise), a locked warp pin's target is its source, curve points are sorted by x with no two at the same x (a curve is sorted when read), a crop rectangle lies in the unit square (it is moved or shrunk to fit), and Auto reads as a manual 0 in every corrector but Main.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "$ref": "#/$defs/nodes"
    }
  },
  "$defs": {
    "nodes": {
      "description": "The graph of the photo: its nodes and the links between them. Left out, `nodes` is the default graph: Input → 1 Main → Output with every field at its default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "description": "The nodes, in no particular order when read (written Input, correctors by id, Output). The Input and the Output are items like the others and cannot be added to or taken out; at most 64 correctors, Main included.",
          "type": "array",
          "maxItems": 66,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/input_node"
              },
              {
                "$ref": "#/$defs/output_node"
              },
              {
                "$ref": "#/$defs/corrector_node"
              }
            ]
          }
        },
        "links": {
          "description": "The links. Left out, the default links (Input → Main → Output); given, they replace the default links whole. At most 129.",
          "type": "array",
          "maxItems": 129,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "input_node": {
      "description": "The Input (`docs/23` section 3.2): the raw, light and framing settings. Every property but `id` is optional when reading and takes its default; the fixed three nodes need not be listed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "input"
        },
        "kind": {
          "const": "input"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "exposure": {
          "$ref": "#/$defs/exposure"
        },
        "light_source": {
          "description": "Colour > White balance presets.",
          "enum": [
            "auto",
            "day",
            "shade",
            "tungsten",
            "led",
            "fluorescent"
          ],
          "default": "auto"
        },
        "white_balance": {
          "$ref": "#/$defs/white_balance"
        },
        "white_pick": {
          "description": "Pick white: [x, y] in [0, 1]^2 on the photo as the camera oriented it, or null.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2
            }
          ],
          "default": null
        },
        "rolloff": {
          "description": "RAW > Range, each 0 to 1 (docs/02 C7). The name is kept from the earlier roll-off card.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "highlights": {
              "description": "The highlight range: where the camera's clipping point lands, from where it was recorded (0) to white, the clip of an ALEXA at EI 800 (1). Mid grey and everything under the knee, two stops below the camera's clip, never move. A document without this field reads as 0.6; an explicit value is kept.",
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.6
            },
            "low_light": {
              "description": "The low-light toe: softens the noise near black (0 is off).",
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        },
        "decode": {
          "description": "RAW > Decode switches; all true by default.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "neural_demosaic": {
              "type": "boolean",
              "default": true
            },
            "highlight_recovery": {
              "type": "boolean",
              "default": true
            },
            "lens_corrections": {
              "type": "boolean",
              "default": true
            },
            "chromatic_aberration": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "noise_reduction": {
          "$ref": "#/$defs/noise_reduction"
        },
        "sharpen": {
          "$ref": "#/$defs/sharpen"
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "crop": {
          "description": "The crop, or null for none.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rect",
                "angle_deg",
                "aspect"
              ],
              "properties": {
                "rect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "angle_deg": {
                  "type": "number",
                  "minimum": -45,
                  "maximum": 45
                },
                "aspect": {
                  "enum": [
                    "free",
                    "original",
                    "square",
                    "four_by_five",
                    "sixteen_by_nine"
                  ]
                },
                "auto": {
                  "description": "The crop is Auto crop's proposal (docs/20-auto-crop.md section 2); absent is false. Rendering never reads it.",
                  "type": "boolean",
                  "default": false
                }
              }
            }
          ],
          "default": null
        },
        "orientation": {
          "description": "Rotation after the camera's EXIF orientation, in degrees clockwise. Any multiple of 90 is read and normalised.",
          "type": "integer",
          "multipleOf": 90,
          "default": 0
        }
      }
    },
    "output_node": {
      "description": "The Output: the look and the sharpening at the size the picture is shown or written.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "output"
        },
        "kind": {
          "const": "output"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "look": {
          "description": "Look id: builtin:<slug>, user:<slug>, arri:<group number>:<slug> or arri-display:<input>:<target>. A document without `look` is read as the user's default look (builtin:signature out of the box) by a session and by `ym render`; the blank value, shown as the default here, is builtin:neutral.",
          "type": "string",
          "pattern": "^(?:(?:builtin|user):[^:\\s]+|arri:[0-9]+:[^:\\s]+|arri-display:[^:\\s]+:[^:\\s]+)$",
          "default": "builtin:neutral"
        },
        "look_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        },
        "output_sharpening": {
          "description": "Detail > Sharpening > Output: the strength of the sharpening applied to the picture at the size it is shown or written, in percent (0 is off). A plain number, not Auto; the UI steps by 5. A document without it reads as 100.",
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 100
        }
      }
    },
    "corrector_node": {
      "description": "A corrector node, Main (id 1) included. A node with an id the default graph does not have must give its `kind`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "A corrector's id: an integer 1 to 2147483647 (Main is 1). Ids are unique within the photo.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "kind": {
          "const": "corrector"
        },
        "pos": {
          "$ref": "#/$defs/pos"
        },
        "name": {
          "description": "1 to 32 characters after trimming; a longer name is cut and an empty one reads as the default (\"Main\" for node 1, \"Corrector\").",
          "type": "string",
          "default": "Corrector"
        },
        "bypass": {
          "type": "boolean",
          "default": false
        },
        "trim": {
          "$ref": "#/$defs/trim"
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "masks": {
          "$ref": "#/$defs/masks"
        }
      }
    },
    "pos": {
      "description": "The card's place on the canvas: [x, y] in grid units, finite numbers in -1000 to 1000 (the core clamps). Left out, the core places the nodes in a row by their number (the Input at -1, the correctors from 0, the Output last), at y = 0.",
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        }
      ],
      "items": false,
      "minItems": 2
    },
    "trim": {
      "description": "A corrector's trims (`docs/algorithms/06` section 2): an exposure trim in stops and a temperature and tint trim.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure_ev": {
          "type": "number",
          "minimum": -4,
          "maximum": 4,
          "default": 0
        },
        "temperature": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        },
        "tint": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        }
      }
    },
    "grade": {
      "description": "A corrector's grade: the fields the settings had before they were nodes. Auto belongs to Main (id 1): in any other corrector Auto reads as a manual 0 and is written as one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contrast": {
          "$ref": "#/$defs/auto_percent"
        },
        "brightness": {
          "$ref": "#/$defs/percent"
        },
        "highlights": {
          "$ref": "#/$defs/auto_percent"
        },
        "shadows": {
          "$ref": "#/$defs/auto_percent"
        },
        "white": {
          "$ref": "#/$defs/percent"
        },
        "black": {
          "$ref": "#/$defs/auto_percent"
        },
        "color_balance": {
          "description": "Three wheels. Shadows and highlights are Auto ([0, 0], or the colour Apple Auto gave that zone, docs/19 section 5) or a manual point; midtones is a point [a, b] in the unit disc.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shadows": {
              "$ref": "#/$defs/auto_disc_point"
            },
            "midtones": {
              "$ref": "#/$defs/disc_point"
            },
            "highlights": {
              "$ref": "#/$defs/auto_disc_point"
            }
          }
        },
        "saturation": {
          "$ref": "#/$defs/auto_percent"
        },
        "color_warp": {
          "description": "Colour > Colour warp (docs/02 C9b): pins that move chosen colours across the chroma plane, in order. At most 16 (the core cuts the rest). No pins by default, which skips the stage. A patch replaces the whole list.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pins": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/warp_pin"
              },
              "default": []
            }
          },
          "default": {
            "pins": []
          }
        },
        "curve": {
          "description": "Luma, red, green and blue curves, 2 to 16 control points each.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "luma": {
              "$ref": "#/$defs/curve"
            },
            "red": {
              "$ref": "#/$defs/curve"
            },
            "green": {
              "$ref": "#/$defs/curve"
            },
            "blue": {
              "$ref": "#/$defs/curve"
            }
          }
        }
      }
    },
    "masks": {
      "description": "A corrector's masks: its Invert and up to 64 rows that add up (`docs/23` section 3.3).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invert": {
          "type": "boolean",
          "default": false
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mask"
          },
          "default": []
        }
      }
    },
    "mask": {
      "description": "One mask row: `kind` and the fields common to every row (mode, invert, enabled, opacity), then the kind's own.",
      "oneOf": [
        {
          "$ref": "#/$defs/mask_object"
        },
        {
          "$ref": "#/$defs/mask_subject"
        },
        {
          "$ref": "#/$defs/mask_people"
        },
        {
          "$ref": "#/$defs/mask_background"
        },
        {
          "$ref": "#/$defs/mask_linear"
        },
        {
          "$ref": "#/$defs/mask_radial"
        },
        {
          "$ref": "#/$defs/mask_brush"
        },
        {
          "$ref": "#/$defs/mask_color_range"
        },
        {
          "$ref": "#/$defs/mask_brightness_range"
        }
      ]
    },
    "mask_object": {
      "description": "Object (SAM 2.1 from clicks or a box): `points` are [x, y, positive] in the photo frame, at most 256; with no point and no box it selects nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "object"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "points": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "boolean"
              }
            ],
            "items": false,
            "minItems": 3
          },
          "default": []
        },
        "box": {
          "description": "[x0, y0, x1, y1] in the photo frame, or null.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 4
            }
          ],
          "default": null
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "grow": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        },
        "refine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "mask_subject": {
      "description": "Subject (Apple Vision's foreground; a Mac that supports it).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "subject"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "grow": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        },
        "refine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "mask_people": {
      "description": "People (Apple Vision's people; a Mac that supports it).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "people"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "grow": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        },
        "refine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "mask_background": {
      "description": "Background (the blur map with a level and a softness).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "background"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "softness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "grow": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        },
        "refine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "mask_linear": {
      "description": "Linear: a line through `center` at `angle_deg` with a feather.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "linear"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
            0.5,
            0.5
          ]
        },
        "angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "default": 0
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        }
      }
    },
    "mask_radial": {
      "description": "Radial: an ellipse with radii in fractions of the long edge.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "radial"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
            0.5,
            0.5
          ]
        },
        "radii": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0.002,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0.002,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
            0.25,
            0.18
          ]
        },
        "angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "default": 0
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        }
      }
    },
    "mask_brush": {
      "description": "Brush: strokes drawn into a raster; at most 100,000 points in all.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
