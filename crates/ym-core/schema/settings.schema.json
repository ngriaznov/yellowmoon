    "link": {
      "description": "A link from an output port to an input port of the same type, picture to picture or key to key. An input has at most one link; the Output's picture is linked once; Main takes its picture from the Input; the links make no circle (`docs/23` section 3.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/node_ref"
        },
        "to": {
          "$ref": "#/$defs/node_ref"
        }
      }
    },
    "node_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "oneOf": [
            {
              "enum": [
                "input",
                "output"
              ]
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          ]
        },
        "port": {
          "enum": [
            "picture",
            "key"
          ]
        }
      }
    },
    "percent": {
      "type": "number",
      "minimum": -100,
      "maximum": 100,
      "default": 0
    },
    "lens": {
      "description": "Look > Lens (docs/21 section 2): the lens and how much of its character each slider brings. All three amounts at 0 is no lens, whatever `kind` says. Choosing a lens does not move the amounts by itself: the card and `ym render --lens` send the lens's starting amounts (`ym lenses list`) with it. A patch may carry only the parts it changes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "default",
            "classic",
            "vintage",
            "petzval",
            "triplet",
            "sonnar",
            "detuned"
          ],
          "default": "default"
        },
        "flares": {
          "description": "Glow around bright light, veiling glare, ghosts and starbursts (L3).",
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "edges": {
          "description": "Edge softness and darkening, colour fringes and the lens's distortion (L2, L4).",
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "anamorphic": {
          "description": "An anamorphic attachment in front of the lens: taller bokeh that takes the lens's own swirl and cat's-eye shapes, horizontal streaks, the anamorphic bend (L1 to L4).",
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        }
      },
      "default": {
        "kind": "default",
        "flares": 0,
        "edges": 0,
        "anamorphic": 0
      }
    },
    "auto_percent": {
      "description": "contrast, highlights, shadows, black and saturation: Auto (0, or Apple Auto's value for the photo, docs/19 section 5), or a manual value from -100 to 100 (the UI steps by 1). A plain number is an older document: it reads as Manual with that value, and 0 as Auto.",
      "oneOf": [
        {
          "$ref": "#/$defs/auto"
        },
        {
          "type": "object",
          "additionalProperties": false,
