      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "color_range"
        },
        "mode": {
          "enum": [
            "add",
            "subtract"
          ],
          "default": "add"
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5
            },
            {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
