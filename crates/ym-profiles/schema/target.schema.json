{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngriaznov/yellowmoon/crates/ym-profiles/schema/target.schema.json",
  "title": "Yellowmoon colour target",
  "description": "data/alexa/target.json, generated by training/sensor_map/build_target.py: the emulation target's curves path, version and provenance (docs/03, last paragraph). A second target would slot in beside it with the same structure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "display_name", "kind", "spectral_curves", "ensemble_csv", "variants_csv", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "display_name": { "type": "string", "minLength": 1 },
    "kind": {
      "description": "'estimate' for curves inferred from published matrices, 'measurement' for measured curves.",
      "enum": ["estimate", "measurement"]
    },
    "spectral_curves": {
      "description": "Curves in rawtoaces-data JSON format, path relative to data/.",
      "type": "string"
    },
    "ensemble_csv": { "type": "string" },
    "variants_csv": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "method", "inputs", "licence", "fit_script", "recommended_variant", "validation", "caveats", "sha256"],
      "properties": {
        "summary": { "type": "string" },
        "method": { "type": "string" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "licence": { "type": "string" },
        "fit_script": { "type": "string" },
        "recommended_variant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior", "K", "lam", "conv"],
          "properties": {
            "prior": { "type": "string" },
            "K": { "type": "integer", "minimum": 1 },
            "lam": { "type": "number" },
            "conv": { "type": "string" }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "published", "tolerance", "gate"],
          "properties": {
            "method": { "type": "string" },
            "published": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rfse_median_pct", "rfse_p90_pct", "emulation_dE00_median", "emulation_dE00_p95_median_over_cameras"],
              "properties": {
                "rfse_median_pct": { "type": "number" },
                "rfse_p90_pct": { "type": "number" },
                "emulation_dE00_median": { "type": "number" },
                "emulation_dE00_p95_median_over_cameras": { "type": "number" }
              }
            },
            "tolerance": { "type": "number", "exclusiveMinimum": 0 },
            "gate": { "type": "string" }
          }
        },
        "caveats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sha256": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "minProperties": 1
        }
      }
    }
  }
}
